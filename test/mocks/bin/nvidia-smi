#!/usr/bin/env bash
# Mock nvidia-smi used by the test harness (put test/mocks/bin first on PATH).
# Emits the CSV contract queried by src/gpu.js:
#   name,temperature.gpu,power.draw,utilization.gpu,clocks.gr,clocks.mem,
#   memory.used,memory.total,pstate,pci.bus_id
# Knobs (environment):
#   MOCK_SMI_GPUS    number of GPUs (default 2)
#   MOCK_SMI_MODE    ok (default) | fail | empty | garbage
#   MOCK_SMI_LOG     file to append one line per invocation (spawn counting)
#   MOCK_SMI_SLOW_MS artificial delay to test the exec timeout path
if [ "${MOCK_SMI_SLOW_MS:-0}" != "0" ]; then sleep "$(python3 -c "print($MOCK_SMI_SLOW_MS/1000)" 2>/dev/null || echo 1)"; fi
if [ -n "${MOCK_SMI_LOG:-}" ]; then echo "$(date +%s%3N)" >> "$MOCK_SMI_LOG"; fi
if [ "${MOCK_SMI_MODE:-ok}" = "fail" ]; then echo "nvidia-smi: command failed: driver not loaded" >&2; exit 1; fi
if [ "${MOCK_SMI_MODE:-ok}" = "empty" ]; then exit 0; fi
if [ "${MOCK_SMI_MODE:-ok}" = "garbage" ]; then echo "this is,not,real,telemetry"; exit 0; fi
if [ "${MOCK_SMI_MODE:-ok}" = "static" ]; then
  echo "NVIDIA GeForce RTX 3060, 64, 118, 100, 1710, 6801, 8000, 12288, P2, 00000000:01:00.0"
  echo "NVIDIA GeForce GTX 1660 SUPER, 71, 110, 100, 1680, 6801, 7800, 12288, P2, 00000000:06:00.0"
  exit 0
fi
N="${MOCK_SMI_GPUS:-2}"
T=$(( $(date +%s) ))
for ((i=0; i<N; i++)); do
  TEMP=$(( 58 + (T + i*7) % 12 ))
  PWR=$(( 95 + (T/5 + i*11) % 45 ))
  UTIL=$(( 92 + (T + i) % 8 ))
  case $(( (T/10 + i) % 4 )) in
    0) CORE=1710;; 1) CORE=1680;; 2) CORE=1740;; 3) CORE=1650;;
  esac
  MEMCLOCK=6801
  USED=$(( 7800 + (T + i*13) % 300 ))
  TOTAL=12288
  PST="P$(( (T/15 + i) % 2 + 1 ))"
  case $i in
    0) NAME="NVIDIA GeForce RTX 3060"; PCI="00000000:01:00.0";;
    1) NAME="NVIDIA GeForce GTX 1660 SUPER"; PCI="00000000:06:00.0";;
    2) NAME="NVIDIA GeForce RTX 3070"; PCI="00000000:05:00.0";;
    *) NAME="NVIDIA GeForce GTX 1080 Ti"; PCI="00000000:09:00.0";;
  esac
  echo "$NAME, $TEMP, $PWR, $UTIL, $CORE, $MEMCLOCK, $USED, $TOTAL, $PST, $PCI"
done
exit 0
