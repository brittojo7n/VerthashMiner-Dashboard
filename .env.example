# =============================================================================
# VerthashMiner Dashboard — Environment Configuration
# =============================================================================

# --- Required: Security ------------------------------------------------------
# Cryptographic secret for session cookies (generate with: node main.js --gen-secret)
SESSION_SECRET=

# --- Required: Miner ---------------------------------------------------------
# Working directory of VerthashMiner (relative to dashboard or absolute)
MINER_CWD=

# Miner launch arguments (--protocol-dump is added automatically)
MINER_ARGS=-u <WALLET_ADDRESS> -p c=VTC -o stratum+tcp://pool.example.com:6144 --verthash-data ..\..\verthash.dat --all-cu-devices

# Miner executable name or path (default: VerthashMiner.exe on Windows, VerthashMiner on Linux)
MINER_EXE=VerthashMiner.exe

# --- Network & Access --------------------------------------------------------
# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (LAN / network access)
HOST=127.0.0.1

# HTTP port (default: 4067, range: 0-65535)
PORT=4067

# Web UI password (mandatory when HOST is non-local like 0.0.0.0)
PASSPHRASE=

# --- Optional & Advanced -----------------------------------------------------
# Mirror miner stdout/stderr directly to the terminal (true/false, default: false)
FORWARD_CONSOLE=false

# GPU polling interval in ms (default: 5000, range: 3000-10000)
# GPU_POLL_MS=5000

# Custom path to an alternate env file
# ENV_FILE=
