# =============================================================================
# VerthashMiner Dashboard — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:
#   PowerShell:  Copy-Item ".env.example" ".env"
#   CMD:         copy .env.example .env
# =============================================================================

# --- Required ---------------------------------------------------------------
# SESSION_SECRET: Cryptographic secret for session cookies (min 32 chars).
# Commands to Generate:
#   node main.js --generate-secret
#   node main.js --gen-secret
SESSION_SECRET=

# --- Miner ------------------------------------------------------------------
# MINER_CWD: Miner working directory (relative to dashboard root or absolute path)
MINER_CWD=

# MINER_EXE: Executable name/path (default: VerthashMiner.exe / VerthashMiner)
MINER_EXE=VerthashMiner.exe

# MINER_ARGS: Miner CLI arguments. --protocol-dump is added automatically.
MINER_ARGS=-u <WALLET_ADDRESS> -p c=VTC -o stratum+tcp://pool.example.com:6144 --verthash-data ..\..\verthash.dat --all-cu-devices

# --- Network ----------------------------------------------------------------
# HOST: 127.0.0.1 (local only) or 0.0.0.0 (LAN — requires PASSPHRASE)
HOST=127.0.0.1

# PASSPHRASE: Web UI password — required when HOST is non-local
PASSPHRASE=

# PORT: HTTP port (default: 4067, range: 0-65535)
PORT=4067

# --- Optional ---------------------------------------------------------------
# GPU_POLL_MS: nvidia-smi poll interval in ms (default: 5000, range: 3000-10000)
# GPU_POLL_MS=5000

# FORWARD_CONSOLE: Mirror miner stdout/stderr to the local CLI/terminal (true/false).
# This is parsed case-insensitively (e.g., TRUE or true) and will output to the terminal regardless of connected web clients.
# FORWARD_CONSOLE=false

# ENV_FILE: Custom path to an alternative env file (OS vars take precedence)
# ENV_FILE=
